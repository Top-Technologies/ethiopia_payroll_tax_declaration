<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_schedule_a_export_wizard_form" model="ir.ui.view">
        <field name="name">schedule.a.export.wizard.form</field>
        <field name="model">schedule.a.export.wizard</field>
        <field name="arch" type="xml">
            <form string="ERCA Tax Declaration - Export to Excel">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>

                <!-- Choose state: display summary and allow export -->
                <div invisible="state != 'choose'">
                    <div class="alert alert-info" role="alert">
                        <strong>ERCA / MoR Schedule A Declaration:</strong>
                        This tool exports the Ethiopian Ministry of Revenues Schedule A Employment Income Tax and Pension Contribution Declaration to an official formatted Excel spreadsheet (.xlsx).
                    </div>
                    <group>
                        <group string="Batch Information">
                            <field name="payslip_run_id" readonly="1" options="{'no_open': True}"/>
                            <field name="company_id" readonly="1" options="{'no_open': True}"/>
                            <label for="date_start" string="Tax Period"/>
                            <div class="o_row">
                                <field name="date_start" readonly="1"/>
                                <span> to </span>
                                <field name="date_end" readonly="1"/>
                            </div>
                        </group>
                        <group string="Declaration Summary">
                            <field name="employee_count" readonly="1"/>
                            <field name="total_taxable_income" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_tax_withheld" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_pension" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                </div>

                <!-- Get state: display download link -->
                <div invisible="state != 'get'">
                    <div class="alert alert-success" role="alert">
                        <strong>Success!</strong> Your ERCA Schedule A Excel declaration has been generated.
                    </div>
                    <group>
                        <field name="excel_filename" invisible="1"/>
                        <field name="excel_file" filename="excel_filename" readonly="1"/>
                    </group>
                </div>

                <footer>
                    <button name="action_export_excel"
                            string="Export to Excel"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-excel-o"
                            invisible="state != 'choose'"/>
                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-secondary"
                            icon="fa-print"
                            invisible="state != 'choose'"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window action for the wizard -->
    <record id="action_schedule_a_export_wizard" model="ir.actions.act_window">
        <field name="name">ERCA Export to Excel</field>
        <field name="res_model">schedule.a.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>

